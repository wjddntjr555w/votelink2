"""{{한글 이름}} 수집기.

fetch: 네트워크에서 원본을 가져온다 (파싱 금지)
parse: 원본 -> 공통 레코드 (네트워크 금지, 순수 함수)
"""

from collections.abc import Iterator
from datetime import datetime

from votelink.collect.base import BaseCollector, RawBatch
from votelink.collect.geo import to_emd_code
from votelink.collect.http import polite_client
from votelink.contract.models import Record


class Collector(BaseCollector):
    id = "{{collector_id}}"

    def fetch(self, since: datetime | None) -> Iterator[RawBatch]:
        with polite_client(self.meta) as client:
            resp = client.get("{{url}}", params={})
            yield RawBatch(collector_id=self.id, body=resp.json())

    def parse(self, raw: RawBatch) -> Iterator[Record]:
        for item in raw.body["{{목록 키}}"]:
            yield Record(
                kind="{{kind}}",
                collector_id=self.id,
                source_name=self.meta.source_name,
                source_url=item.get("url"),
                source_license=self.meta.source_license,
                observed_at=...,          # 데이터가 가리키는 시점
                observed_precision="day",
                geo_level="emd",
                geo_code=to_emd_code(item["{{지역 필드}}"]),   # 실패 시 예외
                geo_name=item["{{지역명 필드}}"],
                confidence=1.0,
                derived_from=[],
                payload={},               # docs/10-data-contract.md 의 kind별 스키마
            )
